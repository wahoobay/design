{
  "name": "@wahoobay/design",
  "version": "0.2.2",
  "description": "Wahoo Bay design system: tokens, components, logo",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahoobay/design.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./fonts.css": "./dist/fonts.css",
    "./logo/*": "./dist/logo/*",
    "./icons/*": "./dist/icons/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test 'tests/*.test.mjs'",
    "check": "impeccable detect dist/index.html"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "impeccable": "4.8.0"
  }
}
